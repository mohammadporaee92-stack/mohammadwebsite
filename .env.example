# ============================================================
# PorAI — Environment variables
# Copy to `.env` and fill in. NEVER commit real secrets to git.
# ============================================================

# --- Database (SQLite by default — zero cost, works on any VPS) ---
# To use Postgres/Supabase later, change schema provider to "postgresql"
# and set e.g. DATABASE_URL="postgresql://user:pass@host:5432/db"
DATABASE_URL="file:./dev.db"

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
DEFAULT_LANG="fa"

# --- Sessions (generate a long random string, min 32 chars) ---
SESSION_SECRET="CHANGE_ME_min_32_characters_long_random_secret"

# --- Owner / admin ---
# Comma-separated phone numbers that automatically become super_admin
# on first OTP login. CHANGE THIS to your own number!
ADMIN_PHONES="09120000000"

# --- SMS / OTP ---
# demo = show code on screen (no cost). kavenegar | ghasedak need API keys.
SMS_PROVIDER="demo"
KAVENEGAR_API_KEY=""
KAVENEGAR_SENDER=""
GHASEDAK_API_KEY=""

# --- Payments (architecture ready, no live gateway connected) ---
# none | zarinpal | stripe
PAYMENT_PROVIDER="none"
ZARINPAL_MERCHANT_ID=""
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Instagram feed (Meta Graph API — connect later) ---
INSTAGRAM_USERNAME="mohammad_por_ai"
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_ENABLED="false"

# --- Newsletter provider (db = store locally; resend|mailchimp later) ---
NEWSLETTER_PROVIDER="db"
RESEND_API_KEY=""

# --- File uploads (local = /public/uploads; s3 later for Vercel-scale) ---
UPLOAD_PROVIDER="local"
