# Copy to .env. Keep real secrets out of git.
DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
DEFAULT_LANG="fa"

# Generate a unique random value of at least 32 characters before running.
SESSION_SECRET=""

# Reserved owner numbers cannot be claimed through public registration.
# No automatic promotion on registration or login.
ADMIN_PHONES=""
# Local operator command: npm run admin:create. Remove the password afterward.
ADMIN_BOOTSTRAP_PHONE=""
ADMIN_BOOTSTRAP_PASSWORD=""

# Optional first seed of an empty DB: POST /api/setup with Bearer authorization.
# Keep unset if using npm run db:seed. There is no remote force reset.
SETUP_SECRET=""

# SMS authentication/recovery endpoints are disabled in this edition.
SMS_PROVIDER="none"

# Paid enrollment stays closed until a verified checkout is implemented.
PAYMENT_PROVIDER="none"
ZARINPAL_MERCHANT_ID=""
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Public social links work without connecting an API.
INSTAGRAM_USERNAME="mohammad_por_ai"
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_ENABLED="false"

# Subscribers are stored locally; there is no email delivery in this edition.
NEWSLETTER_PROVIDER="db"
RESEND_API_KEY=""

# Production must preserve both the SQLite database and uploaded files.
UPLOAD_PROVIDER="local"
