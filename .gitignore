# Dependencies
node_modules/

# Build outputs
.next/
out/
build/
dist/

# Database (local node:sqlite) — data files stay out of git
*.db
*.db-shm
*.db-wal
*.db-journal

# TypeScript build info
tsconfig.tsbuildinfo
*.tsbuildinfo

# Uploads (user content)
/public/uploads/*

# Env & secrets — NEVER commit real secrets
.env
.env*.local

# Logs & OS
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
*.pem

# IDE
.vscode/*
!.vscode/extensions.json
.idea/
